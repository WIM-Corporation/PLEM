<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plem_drive_msgs</name>
  <version>0.10.1</version>
  <description>ROS 2 interfaces of the CiA 402 drive bus: its static facts (DriveInfo) and its level report (DriveStatus).</description>
  <maintainer email="william@wimcorp.co.kr">WIM Inc.</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/WIM-Corporation/PLEM</url>
  <url type="bugtracker">https://github.com/WIM-Corporation/PLEM/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
