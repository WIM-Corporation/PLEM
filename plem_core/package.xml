<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plem_core</name>
  <version>0.10.1</version>
  <description>Core RT utilities (units, logging, monitoring queues, timing, threading) shared by the PLEM drive packages.</description>

  <maintainer email="william@wimcorp.co.kr">WIM Inc.</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <url type="repository">https://github.com/WIM-Corporation/PLEM</url>
  <url type="bugtracker">https://github.com/WIM-Corporation/PLEM/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <!-- spdlog is in the public headers; libsodium is linked privately (no installed header includes it).
       Its run-time library comes with libsodium-dev: rosdep has no key for the library alone. -->
  <depend>spdlog</depend>
  <build_depend>libsodium-dev</build_depend>
  <exec_depend>libsodium-dev</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
