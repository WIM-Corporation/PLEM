 <customMathEquations>
  <!-- A mirrored pair (axis1 = S - axis0): p0 + p1 stays at its first value.
       Its change from the first sample is the position mismatch in rad. -->
  <snippet name="position_mismatch">
   <global>first = nil</global>
   <function>if first == nil then first = value + v1 end
return value + v1 - first</function>
   <linked_source>/a6b_pair/rt_raw/samples/actual_position[0]</linked_source>
   <additional_sources>
    <v1>/a6b_pair/rt_raw/samples/actual_position[1]</v1>
   </additional_sources>
  </snippet>
  <!-- Mirrored speeds cancel: v0 + v1 is 0 rad/s when the pair is in sync. -->
  <snippet name="velocity_sum">
   <global></global>
   <function>return value + v1</function>
   <linked_source>/a6b_pair/rt_raw/samples/actual_velocity[0]</linked_source>
   <additional_sources>
    <v1>/a6b_pair/rt_raw/samples/actual_velocity[1]</v1>
   </additional_sources>
  </snippet>
  <!-- The torque both drives push against each other through the coupling, in N·m. -->
  <snippet name="opposing_torque">
   <global></global>
   <function>return (value + v1) / 2</function>
   <linked_source>/a6b_pair/rt_raw/samples/actual_torque[0]</linked_source>
   <additional_sources>
    <v1>/a6b_pair/rt_raw/samples/actual_torque[1]</v1>
   </additional_sources>
  </snippet>
 </customMathEquations>
 <snippets/>
